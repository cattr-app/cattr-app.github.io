{
  "env": {
    "commonjs": true,
    "es6": true,
    "node": true,
    "browser": true
  },
  "extends": "airbnb-base",
  "plugins": [
    "html"
  ],
  "ignorePatterns": [ "public/**", "build/**" ],
  "parserOptions": {
    "ecmaVersion": 2018
  },
  "rules": {
    "max-len": [
      "warn",
      {
        "code": 120,
        "ignoreStrings": true,
        "ignoreUrls": true,
        "ignoreTemplateLiterals": true
      }
    ],
    "curly": [
      "warn",
      "multi"
    ],
    "padded-blocks": [
      "warn",
      "always"
    ],
    "nonblock-statement-body-position": [
      "warn",
      "below"
    ],
    "arrow-parens": [
      "error",
      "as-needed"
    ]
  }
}
